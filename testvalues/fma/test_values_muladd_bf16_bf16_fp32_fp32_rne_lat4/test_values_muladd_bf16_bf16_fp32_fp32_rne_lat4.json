{
  "$schema": "bf16xbf16+f32 -> f32 fused multiply-add RNE test vectors",
  "format": {
    "input_a": "BF16 VALA (1s/8e/7m)",
    "input_b": "BF16 VALB (1s/8e/7m)",
    "input_s": "FP32 SUMM (1s/8e/23m)",
    "output_c": "FP32 RESULT = SUMM + (VALA × VALB), RNE rounding",
    "special_cases": "NaN in -> qNaN 0x7FC00000; Inf*finite ± Inf -> qNaN; zero*finite + finite -> finite; exact cancellation -> +0",
    "note": "BF16 subnormal operands are NOT flushed to zero (no FTZ). F32 subnormal results use RNE rounding."
  },
